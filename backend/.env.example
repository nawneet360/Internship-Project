# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-before-deploying

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# "*" = allow all (dev only). In production set your frontend URL:
# CORS_ORIGINS=https://your-app.onrender.com,https://your-custom-domain.com
CORS_ORIGINS=*

# ── Model settings ────────────────────────────────────────────────────────────
TRAIN_SAMPLES=1500
LOAD_SAVED_MODELS=true       # set to false on Render (pkl files not committed)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_TO_FILE=true

# ── Prediction history ────────────────────────────────────────────────────────
MAX_HISTORY=100
